{
  "name": "hpsim-studio",
  "private": true,
  "version": "2.0.0",
  "description": "HPSim Studio – moderner Petri-Netz-Editor und -Simulator (Neuauflage von HPSim 1.1)",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:standalone": "tsc -b && vite build --mode standalone",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "examples": "node scripts/embed-legacy-examples.mjs",
    "build:pages": "npm run build:standalone && node scripts/build-pages.mjs"
  },
  "dependencies": {
    "immer": "10.2.0",
    "lucide-react": "0.577.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.21",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "5.1.4",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vite": "7.3.7",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  }
}
